# Copy to .env (local) and mirror these in Vercel -> Project -> Settings -> Environment Variables.
# The sending domain in RESEND_FROM_EMAIL must be verified in Resend (Domains)
# or the API will reject every send.

# Resend API key (required for /api/waitlist).
RESEND_API_KEY=re_...

# Official sending identity for waitlist mail (domain must be verified in Resend).
RESEND_FROM_EMAIL=Sato <hello@satoxbt.com>

# Where owner notifications land.
WAITLIST_OWNER_EMAIL=team.satofinance@gmail.com

# Abuse caps: max signups per IP per window (seconds).
WAITLIST_WINDOW_SECONDS=3600
WAITLIST_MAX_PER_WINDOW=8

# Optional: durable per-IP rate limiting via Upstash Redis REST.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
