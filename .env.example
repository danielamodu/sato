# Copy to .env (local) and mirror these in Vercel -> Project -> Settings -> Environment Variables.

# --- Shared / Durable Redis (Upstash) ---------------------------------------
# Recommended in all deployments; set SATO_REQUIRE_REDIS=true in production to
# fail closed rather than falling back to per-instance memory.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
SATO_REQUIRE_REDIS=false

# --- Waitlist (/api/waitlist) -----------------------------------------------
# The sending domain in RESEND_FROM_EMAIL must be verified in Resend (Domains)
# or the API will reject every send.
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=Sato <hello@satoxbt.com>
WAITLIST_OWNER_EMAIL=team.satofinance@gmail.com
WAITLIST_WINDOW_SECONDS=3600
WAITLIST_MAX_PER_WINDOW=8

# --- Gasless Sponsor Relay (/api/sponsor) -----------------------------------
# Funded testnet STX private key for co-signing sponsored transactions.
SPONSOR_KEY=
SPONSOR_WINDOW_SECONDS=86400
SPONSOR_MAX_PER_WINDOW=200
SPONSOR_IP_MAX_PER_WINDOW=40

# --- Treasury Address (/api/pay & /api/offramp) -----------------------------
# Stacks principal that receives bill & cash-out sBTC payments.
# Defaults to the contract deployer if unset.
SATO_TREASURY_ADDRESS=

# --- Pay Bills / VTPass (/api/pay) ------------------------------------------
VTPASS_BASE_URL=https://sandbox.vtpass.com/api
VTPASS_API_KEY=
VTPASS_SECRET_KEY=
# Dedicated HMAC secret for signing bill quotes (falls back to VTPASS_SECRET_KEY).
PAY_SIGNING_SECRET=
PAY_SPREAD_BPS=150

# --- Naira Cash-Out / Offramp (/api/offramp) --------------------------------
PAYOUT_BASE_URL=https://api.paystack.co
PAYOUT_SECRET_KEY=
# Dedicated HMAC secret for signing offramp quotes (required — fails closed if unset).
OFFRAMP_SIGNING_SECRET=
OFFRAMP_SPREAD_BPS=200
