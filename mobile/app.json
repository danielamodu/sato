{
  "expo": {
    "name": "Sato",
    "slug": "sato",
    "scheme": "sato",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.sato.wallet"
    },
    "android": {
      "package": "app.sato.wallet"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Unlock Sato to reveal your recovery phrase."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
